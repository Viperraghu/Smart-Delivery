# Copy this file to ".env" and fill in your own values. Never commit ".env".

DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/DATABASE_NAME

ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-long-password
SESSION_SECRET_KEY=any-long-random-text

# Set to true when the site is served over HTTPS (cookies become secure-only).
COOKIE_SECURE=false
# Set to true only when the app runs behind your own proxy (Nginx, Caddy, ...)
# so the real visitor IP is read from X-Forwarded-For for rate limiting.
TRUST_PROXY=false

# ---- Delivery ----
DELIVERY_FEE=40
DELIVERY_FREE_ABOVE=499
STORE_PINCODE=627001
# Optional: only these pincode prefixes are served (comma separated). Empty = everywhere.
SERVICEABLE_PREFIXES=

# ---- Online payment (Razorpay). Leave empty to keep Cash on Delivery only. ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL to add in the Razorpay dashboard: https://YOUR-SITE/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=

# ---- New-order alerts (all optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# ---- Photo finder for the admin "Find photo" button (optional) ----
# Pixabay (free key, instant): create an account at https://pixabay.com, then open
# https://pixabay.com/api/docs/ - your key is shown there.
PIXABAY_API_KEY=
# Pexels (new keys are paused right now): https://www.pexels.com/api/
PEXELS_API_KEY=
